# --- Required ---------------------------------------------------------------
# Google OAuth client (reuses the outreach-tracker client; redirect URI
# http://localhost:3000/api/auth/callback/google must be registered on it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Claude — qualifies creators, writes sequences, triages inbox, drafts replies
ANTHROPIC_API_KEY=
# YouTube Data API v3 key (same Google Cloud project → APIs & Services → Credentials → API key)
YOUTUBE_API_KEY=

# --- You (appears in every outreach email; CAN-SPAM requires a postal address)
SENDER_NAME=Percy
SENDER_TITLE=Founder, Loorio
SENDER_ADDRESS=

# --- Notifications -----------------------------------------------------------
# Install the free "ntfy" app on your phone and subscribe to this topic.
# Anyone who knows the topic can read it, so make it long and random.
NTFY_TOPIC=
NOTIFY_DESKTOP=true
# all = every non-spam email · important = only replies/opt-outs/needs-reply
NOTIFY_LEVEL=all
INBOX_POLL_SECONDS=60

# --- Discovery ---------------------------------------------------------------
NICHES=SAT prep tips,study tips college,college life advice,learn something new shorts
MIN_SUBSCRIBERS=5000
MAX_SUBSCRIBERS=1000000
MIN_FIT_SCORE=60
ENRICH_PER_DAY=100

# --- Sending -----------------------------------------------------------------
DAILY_SEND_LIMIT=50
SEND_WINDOW_START=9
SEND_WINDOW_END=17
FOLLOW_UP_DAYS=3,7,14
# true = skip the approval queue and send drafts automatically
AUTO_APPROVE=false

# --- Models ------------------------------------------------------------------
MODEL_FAST=claude-haiku-5-5
MODEL_WRITER=claude-opus-5-5

# --- Server ------------------------------------------------------------------
PORT=3000
APP_URL=http://localhost:3000
